APP_NAME="Siro Core"
APP_ENV=testing
APP_DEBUG=true
APP_KEY=testing_app_key_for_hmac_32chars!!

JWT_SECRET=test_secret_for_core_testing_only_32chars!!
JWT_TTL=3600

CACHE_DRIVER=file
CACHE_TTL=60
CACHE_PREFIX=siro:core:test:

# Use SQLite in-memory for testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_CHARSET=utf8mb4

# Use log driver for testing
MAIL_DRIVER=log
