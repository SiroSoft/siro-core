# NOTE: placeholders only — never commit real secrets here.
# Generate real values when a test actually needs one.
APP_NAME="Siro Core"
APP_ENV=testing
APP_DEBUG=true
APP_KEY=placeholder_app_key_for_tests_only_0000

JWT_SECRET=placeholder_jwt_secret_for_tests_only_0000
JWT_TTL=3600

CACHE_DRIVER=file
CACHE_TTL=60
CACHE_PREFIX=siro:core:test:

# Use SQLite in-memory for testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_CHARSET=utf8mb4

# Use log driver for testing
MAIL_DRIVER=log
