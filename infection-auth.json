{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Auth"
        ]
    },
    "logs": {
        "text": "coverage/infection-auth.log",
        "summary": "coverage/infection-auth-summary.log"
    },
    "mutators": {
        "@default": true,
        "ArrayItemRemoval": false,
        "CastString": false,
        "ConcatOperandRemoval": false,
        "UnwrapStrToUpper": false,
        "UnwrapRtrim": false,
        "BitwiseOr": false,
        "PublicVisibility": false,
        "FalseValue": false,
        "TrueValue": false,
        "IncrementInteger": false,
        "DecrementInteger": false,
        "CastInt": false
    },
    "timeout": 30
}
