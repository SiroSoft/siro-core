<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../../tests/bootstrap.php"
         colors="true"
         cacheDirectory="../../.phpunit.cache"
         executionOrder="default"
         beStrictAboutOutputDuringTests="false"
         failOnRisky="false"
         failOnWarning="false"
>
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>

    <testsuites>
        <!-- Full unit suite: mutation scoring covers all of Auth/ + Cache/, so
             every unit test that exercises those namespaces must be included,
             otherwise MSI collapses because mutants appear uncovered. -->
        <testsuite name="Mutation">
            <directory suffix="Test.php">../../tests/unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">../../Auth</directory>
            <directory suffix=".php">../../Cache</directory>
        </include>
    </source>

    <coverage>
        <report>
            <clover outputFile="../../coverage/clover.xml"/>
            <xml outputDirectory="../../coverage/phpunit-xml"/>
        </report>
    </coverage>
</phpunit>