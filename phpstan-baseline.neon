parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @var with type class\-string is not subtype of native type ''App\\\\Models\\\\User''\.$#'
			identifier: varTag.nativeType
			count: 1
			path: App.php

		-
			message: '#^Method Siro\\Core\\Metrics\:\:key\(\) has parameter \$labels with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Metrics.php

		-
			message: '#^Method Siro\\Core\\Metrics\:\:labelsKey\(\) has parameter \$labels with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Metrics.php

		-
			message: '#^Method Siro\\Core\\Metrics\:\:parseLabelsKey\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Metrics.php

		-
			message: '#^Offset ''help'' on array\{buckets\: array\<int, float\>, values\: array\<string, array\<int, int\>\>, sum\: array\<string, float\>, count\: array\<string, int\>\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: Metrics.php

		-
			message: '#^Parameter \#2 \$contentType of static method Siro\\Core\\Response\:\:raw\(\) expects string, int given\.$#'
			identifier: argument.type
			count: 1
			path: Metrics.php

		-
			message: '#^Path in require\(\) "storage/framework/metrics\.php" is not a file or it does not exist\.$#'
			identifier: require.fileNotFound
			count: 1
			path: Metrics.php

		-
			message: '#^Method Siro\\Core\\Middleware\\VersionMiddleware\:\:override\(\) has parameter \$handler with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Middleware/VersionMiddleware.php

		-
			message: '#^Method Siro\\Core\\Middleware\\VersionMiddleware\:\:resolveOverride\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Middleware/VersionMiddleware.php

		-
			message: '#^Static property Siro\\Core\\Middleware\\VersionMiddleware\:\:\$overrides \(array\<string, array\<string, \(callable\(\)\: mixed\)\|string\>\>\) does not accept non\-empty\-array\<string, array\|\(callable\(\)\: mixed\)\|string\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Middleware/VersionMiddleware.php

		-
			message: '#^Static property Siro\\Core\\Middleware\\VersionMiddleware\:\:\$versions is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: Middleware/VersionMiddleware.php

		-
			message: '#^Method Siro\\Core\\Model\:\:find\(\) should return static\(Siro\\Core\\Model\)\|null but returns Siro\\Core\\Model\.$#'
			identifier: return.type
			count: 1
			path: Model.php

		-
			message: '#^Method Siro\\Core\\Model\:\:hydrateAll\(\) should return array\<int, static\(Siro\\Core\\Model\)\> but returns array\<int, Siro\\Core\\Model\>\.$#'
			identifier: return.type
			count: 1
			path: Model.php

		-
			message: '#^Parameter \#2 \$columns of method Siro\\Core\\DB\\ModelQueryBuilder\:\:eagerLoad\(\) expects array\<int, string\>, array\<int\|string, array\<int, string\>\|string\> given\.$#'
			identifier: argument.type
			count: 1
			path: Model.php

		-
			message: '#^Parameter \#2 \$eagerLoads of method Siro\\Core\\DB\\EagerLoader\:\:load\(\) expects array\<string, array\<int, string\>\>, array\<string, array\<int\|string, array\<int, string\>\|string\>\> given\.$#'
			identifier: argument.type
			count: 1
			path: Model.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 2
			path: Model.php

		-
			message: '#^Method Siro\\Core\\Request\:\:setVersionedHandler\(\) has parameter \$handler with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Request.php

		-
			message: '#^Method Siro\\Core\\Request\:\:versionedHandler\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Request.php
