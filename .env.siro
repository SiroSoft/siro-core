# Siro Framework Default Environment
# This file is bundled with the framework and provides safe defaults.
# Override by creating .env (server) or .env.local (local development).
# All keys here can be overridden.

APP_NAME="Siro API"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.28.1

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_DRIVER=file
CACHE_TTL=3600

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Siro API"

JWT_TTL=3600
JWT_REFRESH_TTL=604800
JWT_ALGORITHM=HS256

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
