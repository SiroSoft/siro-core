    "paths": {
        "/api/widgets": {
            "get": {
                "tags": [
                    "Widgets"
                ],
                "operationId": "widgetIndex",
                "summary": "List all widgets",
                "security": [],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of Widget",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WidgetIndexListResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized — missing or invalid JWT token"
                    },
                    "403": {
                        "description": "Forbidden — insufficient permissions"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
